{
  "name": "fork-ts-checker-webpack-plugin",
  "version": "0.0.0-semantic-release",
  "description": "Runs typescript type checker and linter on separate process.",
  "keywords": [
    "webpack",
    "plugin",
    "typescript",
    "typecheck",
    "ts-loader",
    "webpack",
    "fork",
    "fast"
  ],
  "bugs": {
    "url": "https://github.com/TypeStrong/fork-ts-checker-webpack-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TypeStrong/fork-ts-checker-webpack-plugin.git"
  },
  "license": "MIT",
  "author": "Piotr Ole\u015b <piotrek.oles@gmail.com>",
  "contributors": [
    "Piotr Ole\u015b <piotrek.oles@gmail.com> (https://github.com/piotr-oles)",
    "John Reilly <johnny_reilly@hotmail.com> (https://johnnyreilly.com)"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "cross-env rimraf lib && cross-env tsc --version && cross-env tsc",
    "lint": "cross-env oxlint src test",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "cross-env jest --config=test/unit/jest.config.js",
    "test:e2e": "npm pack && cross-env jest --config=test/e2e/jest.config.js --ci -i -b",
    "commit": "cross-env git-cz",
    "semantic-release": "semantic-release",
    "prepare": "husky",
    "format:check": "cross-env prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "chokidar": "^4.0.3",
    "cosmiconfig": "^9.0.2",
    "deepmerge": "^4.3.1",
    "fs-extra": "^11.4.1",
    "memfs": "^3.6.0",
    "minimatch": "^9.0.9",
    "node-abort-controller": "^3.0.1",
    "picocolors": "^1.1.1",
    "schema-utils": "^4.8.3",
    "semver": "^7.8.6",
    "tapable": "^2.3.4"
  },
  "peerDependencies": {
    "typescript": ">3.6.0",
    "webpack": "^5.11.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/babel__code-frame": "^7.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@yarnpkg/cli-dist": "4.7.0",
    "commitlint": "^20.5.3",
    "cross-env": "^7.0.3",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "json-schema": "^0.4.0",
    "karton": "^0.4.1",
    "lint-staged": "^15.5.2",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "rimraf": "^5.0.10",
    "semantic-release": "^25.0.9",
    "strip-ansi": "^6.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "6.0.3",
    "webpack": "^5.112.2"
  },
  "engines": {
    "node": ">=14.21.3"
  },
  "packageManager": "npm@11.21.2"
}
