{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "lib": ["ES6"],
    "strict": false,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "paths": {
      "src/*": ["../src/*"]
    }
  },
  "include": ["../src", "**/*.spec.ts"],
  "exclude": ["node_modules"]
}
