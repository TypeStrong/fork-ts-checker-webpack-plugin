{
  "name": "fork-ts-checker-webpack-plugin devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerUser": "node",
  "remoteUser": "node",
  "postCreateCommand": [
    "npm",
    "ci"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "oxc.oxc-vscode"
      ]
    }
  }
}
