{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "./src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "outDir": "./lib",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src"],
  "exclude": ["node_modules", "test", "lib"]
}
