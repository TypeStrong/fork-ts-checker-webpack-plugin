{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "strict": false,
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "src/*": ["../src/*"],
      "lib/*": ["../lib/*"]
    }
  },
  "include": ["../src", "**/*.spec.ts", "**/*.ts"],
  "exclude": ["node_modules", "e2e/fixtures"]
}
