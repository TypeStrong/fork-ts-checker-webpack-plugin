{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "lib": ["ES6", "DOM"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["./src"],
  "exclude": ["node_modules"]
}
