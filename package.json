{
  "name": "fork-ts-checker-webpack-plugin",
  "version": "0.0.0-semantic-release",
  "description": "Runs typescript type checker and linter on separate process.",
  "keywords": [
    "webpack",
    "plugin",
    "typescript",
    "typecheck",
    "ts-loader",
    "webpack",
    "fork",
    "fast"
  ],
  "bugs": {
    "url": "https://github.com/TypeStrong/fork-ts-checker-webpack-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TypeStrong/fork-ts-checker-webpack-plugin.git"
  },
  "license": "MIT",
  "author": "Piotr Oleś <piotrek.oles@gmail.com>",
  "contributors": [
    "Piotr Oleś <piotrek.oles@gmail.com> (https://github.com/piotr-oles)",
    "John Reilly <johnny_reilly@hotmail.com> (https://johnnyreilly.com)"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc --version && tsc",
    "lint": "tsc -p . --noEmit && tsc -p test --noEmit && oxlint src test",
    "test": "yarn build && yarn test:unit && yarn test:e2e",
    "test:unit": "jest --config=test/unit/jest.config.js",
    "test:e2e": "npm pack && cross-env YARN_ENABLE_IMMUTABLE_INSTALLS=false jest --config=test/e2e/jest.config.js --ci -i -b",
    "precommit": "lint-staged && yarn build && yarn test:unit",
    "commit": "git-cz",
    "semantic-release": "semantic-release",
    "prepare": "husky",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@babel/code-frame": "^7.16.7",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.1",
    "cosmiconfig": "^8.2.0",
    "minimatch": "^3.0.4",
    "schema-utils": "^4.3.0",
    "semver": "^7.3.5",
    "tapable": "^2.2.1"
  },
  "peerDependencies": {
    "typescript": ">=7.1.0-beta",
    "webpack": "^5.11.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^8.0.1",
    "@semantic-release/exec": "^5.0.0",
    "@semantic-release/github": "^7.2.3",
    "@semantic-release/npm": "^7.1.3",
    "@semantic-release/release-notes-generator": "^9.0.3",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/babel__code-frame": "^7.0.3",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.9",
    "@types/minimatch": "^3.0.5",
    "@types/node": "^22",
    "@types/semver": "^7.3.9",
    "commitlint": "^21.2.4",
    "cross-env": "^7.0.3",
    "git-cz": "^4.8.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "json-schema": "^0.4.0",
    "karton": "^0.4.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.10.1",
    "semantic-release": "^17.4.4",
    "typescript": "7.1.0-beta",
    "webpack": "^5.67.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.18.1"
}
