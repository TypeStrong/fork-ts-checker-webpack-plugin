{
  "compilerOptions": {
    "target": "ES6",
    "module": "node16",
    "lib": ["ES6"],
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "declaration": true,
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./lib",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src"],
  "exclude": ["node_modules", "test", "lib"]
}
